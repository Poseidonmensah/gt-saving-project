# ============================================================
# GOOD TIME SAVING & LOANS — Environment Configuration
# ============================================================

# Application
NODE_ENV=development
PORT=3000
APP_NAME=GoodTimeSLS
APP_VERSION=1.0.0
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=goodtime_sls
DB_USER=gtsl_app
DB_PASSWORD=StrongDBPassword@2026
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET="4f2a9e5c3b1d7a8e4d6c8f%2a9e5c3b1d79+a8f0*e6b4c-9d2f3"
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET="4f2a9e5c3b1d7a8f0e6b4c9d2f3,a1b0e4d6c8f%2a9e5c3b1dD=*`8f0*e6b4c-9d2f3"
JWT_REFRESH_EXPIRES_IN=7d

# MFA
MFA_APP_NAME=GoodTimeSLS
MFA_ISSUER=GoodTimeSavingsAndLoans

# Security
BCRYPT_ROUNDS=12 
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=30
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# File Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=10
VIRUS_SCAN_ENABLED=false

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@goodtimeloans.com.gh
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM_NAME=Good Time S&L
EMAIL_FROM_ADDRESS=noreply@goodtimeloans.com.gh

# SMS Provider (e.g. Hubtel Ghana)
SMS_PROVIDER=hubtel
SMS_API_KEY=your-hubtel-api-key
SMS_CLIENT_ID=your-hubtel-client-id
SMS_CLIENT_SECRET=your-hubtel-client-secret
SMS_SENDER_ID=GoodTime

# Mobile Money — MTN MoMo
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your-mtn-subscription-key
MTN_MOMO_API_USER=your-api-user
MTN_MOMO_API_KEY=your-api-key
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_WEBHOOK_SECRET=your-webhook-secret

# Mobile Money — Vodafone Cash
VODAFONE_BASE_URL=https://api.vodafone.com.gh
VODAFONE_USERNAME=your-username
VODAFONE_PASSWORD=your-password
VODAFONE_SHORTCODE=your-shortcode
VODAFONE_WEBHOOK_SECRET=your-webhook-secret

# Bank Integration — GCB
GCB_BASE_URL=https://api.gcb.com.gh
GCB_CLIENT_ID=your-client-id
GCB_CLIENT_SECRET=your-client-secret
GCB_ACCOUNT_NUMBER=your-account-number

# KYC Provider
KYC_PROVIDER_URL=https://api.kyc-provider.com
KYC_API_KEY=your-kyc-api-key

# Credit Bureau
CREDIT_BUREAU_URL=https://api.creditbureau.com.gh
CREDIT_BUREAU_API_KEY=your-bureau-api-key
CREDIT_BUREAU_INSTITUTION_ID=your-institution-id

# Reporting
REPORT_TIMEOUT_MS=120000
REPORT_MAX_ROWS=100000

# Encryption
ENCRYPTION_KEY="4f2a9e5c3b!@^h0e6b4c9d2f3,a1b0e4d6c8f%2a9e5c3b1d79+a8f0*e6b4c-9d2f3"
ENCRYPTION_IV_LENGTH=16

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
